# 22 NEXT GEN environment variables. Copy to .env.local for local work; set the same names in Vercel.
# Never commit real values. Variables prefixed NEXT_PUBLIC_ are visible to browsers; all others are server-only.

# --- Site -------------------------------------------------------------------------------------
# Public origin used for canonical URLs, sitemap, Open Graph and JSON-LD (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Athlete profile pages are NOT indexed by search engines unless this is exactly "true".
# Product/legal decision for 22 Fitness LLC and counsel (youth privacy).
ATHLETE_PROFILES_INDEXABLE=false

# --- Supabase ---------------------------------------------------------------------------------
# Local (supabase start prints these) or hosted project values (Project Settings > API).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used by the Jotform webhook, the owner bootstrap script and role lookup. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Owner bootstrap (used once by `npm run bootstrap:owner`, then remove) ---------------------
OWNER_EMAIL=
OWNER_PASSWORD=

# --- Jotform ----------------------------------------------------------------------------------
# API key with read access to submissions (Jotform > Settings > API). Server-only.
JOTFORM_API_KEY=
# Long random string. Configure the Jotform webhook as https://YOUR-DOMAIN/api/webhooks/jotform?token=THIS_VALUE
JOTFORM_WEBHOOK_SECRET=
# Use https://eu-api.jotform.com for EU accounts. Only https jotform.com / jotform.pro hosts are accepted.
JOTFORM_API_BASE=https://api.jotform.com

# --- Analytics --------------------------------------------------------------------------------
# GA4 measurement ID (G-XXXXXXXXXX). Leave blank to disable. Loads only after the visitor accepts the consent banner.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# --- Stripe (data model only in this release; nothing reads these yet) -------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
